# Resend — the waitlist's storage and sending.
RESEND_API_KEY=
# Sender shown to recipients: "Display Name <local@your-verified-domain>".
WAITLIST_FROM=Offhrs <hello@offhrs.fun>
# Where replies go. Leave blank to omit the Reply-To header.
WAITLIST_REPLY_TO=
# Soft cap on the waitlist. Defaults to 200 when unset.
WAITLIST_CAP=200

# Beta / invite-only. Defaults to on; set to "false" to open the product.
# While on: the menu hides the dashboard/vault entries, the hero and closing CTA
# point at the waitlist, and the landing section CTAs render disabled.
NEXT_PUBLIC_BETA=true

# ── RPC ───────────────────────────────────────────────────────────────
# Dedicated endpoints (Helius / QuickNode free tiers) remove the public-cluster
# rate limits. Both are server-only — the keys never reach the browser.
#   PROGRAM_RPC_URL   the stock_vault program's cluster (devnet until mainnet)
#   RPC_URL           mainnet market reads: PreStocks, Pyth, Jupiter
# The browser client uses NEXT_PUBLIC_SOLANA_RPC_URL, which IS shipped to the
# browser — keep that on the public endpoint or a separate restricted key.
# PROGRAM_RPC_URL=https://devnet.helius-rpc.com/?api-key=
# RPC_URL=https://mainnet.helius-rpc.com/?api-key=

# ── Devnet faucet (beta testers) ─────────────────────────────────────
# Sends a connected wallet test SOL + mock PreStock + wPreStock. On by default
# when NEXT_PUBLIC_SOLANA_RPC_URL points at devnet; the server refuses on mainnet
# regardless. The signing key is server-only — it defaults to ANCHOR_WALLET
# (~/.config/solana/id.json), which is the mock mints' authority. For a public
# beta, point FAUCET_KEYPAIR at a dedicated devnet wallet instead.
# NEXT_PUBLIC_DEVNET_FAUCET=false
# FAUCET_KEYPAIR=
